# Copy this file to .env and fill in LLM_API_KEY before running anything.
# Full schema documented in CLAUDE.md §7 — keep the two in sync if you add a variable.

# --- LLM ---
LLM_PROVIDER=anthropic            # anthropic | openai | litellm
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_BACKOFF_SECONDS=1.0      # base delay for exponential backoff on 429/503 before retrying the primary

# Fallback provider (optional) — only tried after LLM_FALLBACK_MAX_RETRIES
# attempts against the primary exhaust on a transient 429/503 error. Leave
# unset for primary-only behavior (the default). Same shape as the primary
# LLM_* block above, just for the fallback.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-4o
# LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MAX_RETRIES=2

# Vertex AI (GCP service-account) auth via litellm — only used when
# LLM_PROVIDER=litellm and LLM_MODEL starts with "vertex_ai/" (e.g.
# vertex_ai/gemini-2.0-flash). Auth itself comes from GOOGLE_APPLICATION_CREDENTIALS
# (a path to a service-account JSON key, set directly in the process environment,
# not here) — LLM_API_KEY is ignored on this path. Ignored entirely by the
# anthropic/openai providers and by litellm's plain-API-key routes (e.g. gemini/...).
# LLM_VERTEX_PROJECT=my-gcp-project-id
# LLM_VERTEX_LOCATION=us-central1

# Ollama (local models) via litellm — only used when LLM_MODEL (or a
# per-debate override) starts with "ollama/" (e.g. ollama/llama3.1). No API
# key needed; Ollama has no auth by default. Only override if Ollama is
# running somewhere other than its own default.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Debate defaults ---
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_NUM_ROUNDS=3
CONVERGENCE_HIGH_THRESHOLD=0.75
CONVERGENCE_LOW_THRESHOLD=0.4
CONFLICT_RESOLUTION_STRATEGY=flag_unresolved

# --- Storage ---
# When running via docker-compose, MONGO_URI / REDIS_URL are overridden to point at the
# `mongo` / `redis` service names — see docker-compose.yml. These defaults are for running
# the API directly on your host against services also running on localhost.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=investment_committee
REDIS_URL=redis://localhost:6379/0
TRACE_JSON_DIR=./traces

# --- Observability ---
MLFLOW_TRACKING_URI=./mlruns
PROMETHEUS_PORT=9100
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
